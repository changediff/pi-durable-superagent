{
  "name": "pi-durable-superagent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "dsh-superagent's Router/Worker domain (Tickets, Mandates, admission, outbox) ported from DeepSeek Harness to @earendil-works/pi-durable, with a Feishu source and GLM-5.3 models.",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "src/pi/main.ts",
  "exports": {
    ".": {
      "types": "./src/pi/main.ts",
      "default": "./src/pi/main.ts"
    },
    "./plugin": {
      "types": "./src/plugin/index.ts",
      "default": "./src/plugin/index.ts"
    }
  },
  "scripts": {
    "start": "node --experimental-transform-types --no-warnings src/pi/main.ts",
    "selftest": "node --experimental-transform-types --no-warnings src/pi/main.ts --selftest",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "@larksuiteoapi/node-sdk": "1.76.0",
    "proper-lockfile": "4.1.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
